        <script>
    var seconds = 60;
    var totalSeconds = seconds;
    var started = false;
    var circumference = 2 * Math.PI * 52;

    function updateRing() {
        var el = document.getElementById('nvDlRing');
        if (!el) return;
        el.style.strokeDasharray = circumference;
        var progress = totalSeconds > 0 ? (seconds / totalSeconds) : 0;
        el.style.strokeDashoffset = circumference * (1 - progress);
    }

    function display() {
        $('.btn-free-element').hide();
        $('.download-timer').show();
        if (seconds <= 0) {
            $('.nv-dl-ring').hide();
            $('.nv-dl-timer-label').hide();
            $('.nv-dl-ready').show().html("<a class='nv-btn nv-btn--primary nv-btn--lg' href='https://fileup.to/mbgy?pt=Q2gybDlwSlNLUkNaMk0yTm9EdzJ3bXd4ZVN0SWFWQkNXRVE0VFdOMk5FMVJla1J5UVhjOVBRPT0%3D'>download / view now</a>");
            clearInterval(countdownTimer);
        } else {
            $('.download-timer-seconds').html(seconds);
            updateRing();
        }
        seconds--;
    }

    function triggerFreeDownload() {
        if (started === true) return;
        started = true;
        display();
        countdownTimer = setInterval(display, 1000);
    }

    $(document).ready(function () {
        updateRing();
        display();
        $('.download-timer-seconds').html(60);
        countdownTimer = setInterval(display, 1000);
    });
</script>
    

        
